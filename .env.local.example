# Copy to .env.local — never commit filled values.
# Client #2: use YOUR accounts. Never copy Fashion Point production env or Vercel variables.
# Full runbook: docs/WHITE_LABEL_CLIENT_2_RUNBOOK.md

# --- Required: Supabase (new project per client) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Required in production: public HTTPS origin (same host, no trailing slash) ---
# Used for metadata, sitemap, robots, and as email-link fallback.
# If NEXT_PUBLIC_SITE_URL is unset, site-config falls back to the Fashion Point template domain.
# Local development:
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example (replace with Client #2 domain — not a Vercel preview URL):
# APP_URL=https://YOUR-CLIENT-DOMAIN.com
# NEXT_PUBLIC_SITE_URL=https://YOUR-CLIENT-DOMAIN.com
# NEXT_PUBLIC_APP_URL=https://YOUR-CLIENT-DOMAIN.com
# OPTIONAL fallback if APP_URL is unset (same origin rules):
# NEXT_PUBLIC_APP_URL=https://YOUR-CLIENT-DOMAIN.com

# --- Email (Resend) ---
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Mailbox only. Display name comes from Admin → Store Information at send time.
# Production: verified address on Client #2's domain. Unset mailbox falls back to onboarding@resend.dev (test only).
RESEND_FROM_EMAIL=orders@YOUR-CLIENT-DOMAIN.com

# --- Staff alert recipients (Client #2 inboxes — never Fashion Point production addresses) ---
ADMIN_EMAIL=admin@YOUR-CLIENT-DOMAIN.com
# OPTIONAL comma-separated worker inboxes
WORKER_EMAILS=admin@YOUR-CLIENT-DOMAIN.com
ADMIN_PHONE=YOUR_ADMIN_PHONE_DIGITS
# OPTIONAL WhatsApp destination override (defaults to whatsapp:+91{ADMIN_PHONE})
# ADMIN_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# --- Payments (OPTIONAL until checkout is enabled; missing keys → demo mode) ---
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# --- Images (OPTIONAL in local dev; required for production Cloudinary uploads) ---
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# --- OPTIONAL: Twilio WhatsApp ---
# TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- OPTIONAL: Meta WhatsApp Cloud API (separate from Twilio) ---
# WHATSAPP_API_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- OPTIONAL: SMS gateway ---
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=

# --- OPTIONAL: Firebase / PWA push ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVER_KEY=
# FCM_SERVER_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- OPTIONAL: cron (required only if you schedule /api/cron/* ) ---
# CRON_SECRET=YOUR_CRON_SECRET
# Admin approval reminder delay in minutes (default 120 if unset)
REMINDER_DELAY_MINUTES=120

# --- OPTIONAL: AI APIs ---
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# REPLICATE_API_TOKEN=YOUR_REPLICATE_API_TOKEN

# --- OPTIONAL: analytics ---
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_CLARITY_ID=

# --- OPTIONAL: shipping / Rapido (Admin → Settings can also store provider settings) ---
# DELIVERY_PROVIDER=mock
# RAPIDO_API_KEY=
# RAPIDO_API_SECRET=

# --- OPTIONAL: one-off scripts only (migrate-base64-*, reset-inventory) ---
# DRY_RUN=true

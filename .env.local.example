NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
GOOGLE_CLOUD_VISION_API_KEY=your_google_vision_key
OPENAI_API_KEY=your_openai_key
RESEND_API_KEY=your_resend_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Admin alerts — use env vars only (never hardcode in source)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PHONE=your_admin_phone_digits
# Optional: override WhatsApp destination (defaults to whatsapp:+91{ADMIN_PHONE})
# ADMIN_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
# Twilio WhatsApp sender (alias: TWILIO_WHATSAPP_FROM)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Firebase Cloud Messaging (PWA push)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Optional: FCM legacy server key for token-based push
# FIREBASE_SERVER_KEY=
# Optional: Web Push VAPID (fallback when Firebase not configured)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Cron secret for order reminder job
# CRON_SECRET=
# Admin approval reminder delay in minutes (default: 120 = 2 hours; use 10 for testing)
REMINDER_DELAY_MINUTES=120
REPLICATE_API_TOKEN=your_replicate_token
NEXT_PUBLIC_SITE_URL=https://fashionpointvijayawada.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
